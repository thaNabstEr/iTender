---
import type { Desk, DeskTender } from '../lib/desk.ts';
import { shortDoc } from '../lib/desk.ts';
import { fmtDay } from '../lib/dates.ts';
import { rand } from '../lib/money.ts';
import Closes from './Closes.astro';
import Dash from './Dash.astro';

interface Props { desk: Desk; bids: DeskTender[] }
const { desk, bids } = Astro.props;
---
<div class="tablebox">
  <table>
    <thead><tr><th>Bid</th><th class="num">Date</th><th class="num">Documents</th><th class="num">Your price</th><th>Next step</th></tr></thead>
    <tbody>
      {bids.map((t) => {
        const stage = desk.stage(t);
        const href = `/tenders/${encodeURIComponent(t.ocid)}`;
        const missing = desk.missingDocs(t);
        const total = t.bid!.docs.length;
        const price = desk.bidPrice(t);
        const expected = desk.resultExpected(t);
        return (
          <tr>
            <td><a class="tname" href={href}>{t.title ?? t.reference}</a><div class="sub">{t.entity ?? <Dash />}</div></td>
            <td class="num">
              {stage === 'preparing' ? <Closes desk={desk} t={t} />
                : stage === 'submitted' ? (t.bid!.submittedAt ? `Submitted ${fmtDay(t.bid!.submittedAt)}` : 'Submitted')
                : t.closesAt ? `Closed ${fmtDay(t.closesAt)}` : <Dash />}
            </td>
            <td class="num">{stage === 'preparing' ? (total ? `${total - missing.length} of ${total}` : <Dash />) : <span class="sub">Sent</span>}</td>
            <td class="num">{price ? rand(price) : <span class="sub">Not priced</span>}</td>
            <td>
              {stage === 'preparing' ? (
                missing.length ? (
                  <a href={href}>{desk.closesSoon(t) ? <span class="mark">Finish {shortDoc(missing[0].name)}</span> : `Finish ${shortDoc(missing[0].name)}`}</a>
                ) : total ? <a href={`${href}/submit`}>Mark as submitted</a> : <a href={href}>Build the checklist</a>
              ) : stage === 'submitted' ? (
                <span class="sub">Closes {t.closesAt ? fmtDay(t.closesAt) : <Dash />}</span>
              ) : desk.resultDue(t) ? (
                <a href={`${href}/result`}><span class="mark">Record the result</span></a>
              ) : (
                <span class="sub">Result expected around {expected ? fmtDay(expected) : <Dash />}</span>
              )}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
