---
// A tick for done, an open circle for still to do. Always next to a word, never on its own.
interface Props { ok: boolean }
const { ok } = Astro.props;
---
{ok
  ? <svg class="tick" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  : <svg class="tick" aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>}

<style>
  .tick {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--forest);
  }
</style>
