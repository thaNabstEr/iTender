---
// A small pill for confirmations. Never for errors that need action.
---
<div class="toast" id="toast" role="status" hidden transition:persist></div>

<script>
  let timer: ReturnType<typeof setTimeout> | undefined;
  window.toast = (message: string) => {
    const el = document.getElementById('toast');
    if (!el) return;
    el.textContent = message;
    el.hidden = false;
    clearTimeout(timer);
    timer = setTimeout(() => (el.hidden = true), 2600);
  };
  // A page can ask for a toast after a form action with data-toast on <main>.
  document.addEventListener('astro:page-load', () => {
    const msg = document.querySelector<HTMLElement>('main[data-toast]')?.dataset.toast;
    if (msg) window.toast(msg);
  });
</script>

<style>
  .toast {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    background: var(--ink);
    color: #FFFFFF;
    padding: 12px 22px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    max-width: calc(100% - 32px);
    z-index: 50;
    box-shadow: 0 6px 24px rgba(14, 15, 12, .18);
  }
</style>
