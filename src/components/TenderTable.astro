---
import type { Desk, DeskTender } from '../lib/desk.ts';
import { TYPE_LABEL } from '../lib/desk.ts';
import Closes from './Closes.astro';
import Dash from './Dash.astro';

interface Props { desk: Desk; tenders: DeskTender[] }
const { desk, tenders } = Astro.props;
const STAGE = { preparing: 'Preparing', submitted: 'Submitted', awaiting: 'Awaiting result', won: 'Won', lost: 'Lost', cancelled: 'Cancelled' };
---
<div class="tablebox">
  <table>
    <thead><tr><th>Tender</th><th>Province</th><th>Type</th><th class="num">Closes</th><th class="num"><span class="visually-hidden">Your bid</span></th></tr></thead>
    <tbody>
      {tenders.map((t) => {
        const stage = desk.stage(t);
        const href = `/tenders/${encodeURIComponent(t.ocid)}`;
        return (
          <tr>
            <td>
              <a class="tname" href={href}>{t.title ?? t.reference}</a>
              {!t.openedAt && !t.bid && <span class="tag">New</span>}
              <div class="sub">{t.entity ?? <Dash />}</div>
            </td>
            <td>{t.province ?? <Dash />}</td>
            <td>{t.tenderType ? TYPE_LABEL[t.tenderType] : <Dash />}</td>
            <td class="num"><Closes desk={desk} t={t} /></td>
            <td class="num">{stage && <a href={href} class="sub" style="color:var(--ink)">{STAGE[stage]}</a>}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
