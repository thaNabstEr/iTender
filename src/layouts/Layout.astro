---
import { ClientRouter } from 'astro:transitions';
import Splash from '../components/Splash.astro';
import Banner from '../components/Banner.astro';
import Toast from '../components/Toast.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  /** A confirmation to show once the page loads, e.g. after a form action. */
  toast?: string;
}
const { title, toast } = Astro.props;
const desk = await Astro.locals.desk();
const counts = desk.counters();
const profile = desk.profile;

const path = Astro.url.pathname;
const section = path === '/' ? 'home' : path.split('/')[1];
// A tender belongs under My bids once there's a bid on it.
const tenderOcid = section === 'tenders' && path.split('/')[2] ? decodeURIComponent(path.split('/')[2]) : null;
const navOn = tenderOcid && desk.tenders.find((t) => t.ocid === tenderOcid)?.bid ? 'bids' : section;

const nav = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'tenders', href: '/tenders', label: 'Tenders', count: counts.tenders, hint: 'new' },
  { key: 'bids', href: '/bids', label: 'My bids', count: counts.bids, hint: 'active' },
  { key: 'vault', href: '/vault', label: 'Vault', count: counts.vault, hint: 'need attention' },
  { key: 'prices', href: '/prices', label: 'Prices' },
  { key: 'settings', href: '/settings', label: 'Settings' },
];
const initials = (profile?.initials ?? '').slice(0, 2).toUpperCase();
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · Tender desk` : 'Tender desk'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <ClientRouter fallback="none" />
  </head>
  <body>
    <Splash />
    <div class="app">
      <aside class="side">
        <a class="brand" href="/">Tender desk</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={{ on: navOn === n.key }} aria-current={navOn === n.key ? 'page' : undefined}>
              {n.label}
              {n.count ? <>{" "}<span class="count">{n.count}<span class="visually-hidden"> {n.hint}</span></span></> : null}
            </a>
          ))}
        </nav>
        <a class="who" href="/settings">
          <span class="avatar" aria-hidden="true">{initials}</span>
          <span><span class="n">{profile?.name ?? 'Your company'}</span><br /><span class="sub">Company profile</span></span>
        </a>
      </aside>
      <main data-toast={toast}>
        <Banner items={desk.bannerItems()} />
        <slot />
      </main>
    </div>
    <Toast />
  </body>
</html>

<style>
  .app {
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr);
    min-height: 100vh;
  }

  .side {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    height: 100vh;
    padding: 28px 16px 24px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: var(--page);
  }

  .brand {
    font-size: 21px;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--forest);
    padding: 0 14px;
  }

  .side nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }

  .side nav a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .side nav a:hover {
    background: var(--soft);
    color: var(--ink);
  }

  .side nav a.on {
    background: var(--range);
    color: var(--forest);
    font-weight: 700;
  }

  .count {
    background: var(--forest);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    min-width: 24px;
    padding: 1px 8px;
    border-radius: 9999px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .who {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 20px;
    text-decoration: none;
    color: var(--ink);
  }

  .who:hover {
    background: var(--soft);
    color: var(--ink);
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--on-lime);
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 14px;
    flex-shrink: 0;
  }

  .who .n {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
  }

  main {
    padding: 32px 48px 96px;
    max-width: 1120px;
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 860px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: sticky;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-right: none;
      border-bottom: 1px solid var(--line);
      z-index: 10;
    }

    /* Covers the notch area above the sticky bar. */
    :global(body)::before {
      content: "";
      position: fixed;
      inset: 0 0 auto;
      height: env(safe-area-inset-top, 0px);
      z-index: 11;
      background: var(--page);
    }

    .brand {
      padding: 0;
      font-size: 18px;
      white-space: nowrap;
    }

    .side nav {
      flex-direction: row;
      overflow-x: auto;
      gap: 2px;
    }

    .who {
      display: none;
    }

    main {
      padding: 24px 20px 80px;
    }
  }
</style>
