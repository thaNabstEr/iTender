---
import { ClientRouter } from 'astro:transitions';
import Splash from '../components/Splash.astro';
import Banner from '../components/Banner.astro';
import Toast from '../components/Toast.astro';
import Icon from '../components/Icon.astro';
import { Home01Icon, Search01Icon, Briefcase01Icon, FolderLockedIcon, Tag01Icon, Settings01Icon, SidebarLeftIcon } from '@hugeicons/core-free-icons';
import '../styles/global.css';

interface Props {
  title?: string;
  /** A confirmation to show once the page loads, e.g. after a form action. */
  toast?: string;
}
const { title, toast } = Astro.props;
const desk = await Astro.locals.desk();
const counts = desk.counters();

const path = Astro.url.pathname;
const section = path === '/' ? 'home' : path.split('/')[1];
// A tender belongs under My bids once there's a bid on it.
const tenderOcid = section === 'tenders' && path.split('/')[2] ? decodeURIComponent(path.split('/')[2]) : null;
const navOn = tenderOcid && desk.tenders.find((t) => t.ocid === tenderOcid)?.bid ? 'bids' : section;

const nav = [
  { key: 'home', href: '/', label: 'Home', icon: Home01Icon },
  { key: 'tenders', href: '/tenders', label: 'Tenders', icon: Search01Icon, count: counts.tenders, hint: 'new' },
  { key: 'bids', href: '/bids', label: 'My bids', icon: Briefcase01Icon, count: counts.bids, hint: 'active' },
  { key: 'vault', href: '/vault', label: 'Vault', icon: FolderLockedIcon, count: counts.vault, hint: 'need attention' },
  { key: 'prices', href: '/prices', label: 'Prices', icon: Tag01Icon },
  { key: 'settings', href: '/settings', label: 'Settings', icon: Settings01Icon },
];
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · iTender` : 'iTender'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <ClientRouter fallback="none" />
    <script is:inline>
      // Set before paint, and again after each page swap, so a collapsed sidebar doesn't flash open
      // and a splash that has already played doesn't flash in.
      (() => {
        const side = () => {
          document.documentElement.dataset.side = localStorage.getItem('td-side') ?? 'open';
          if (localStorage.getItem('td-splash-seen')) document.documentElement.dataset.splash = 'seen';
        };
        side();
        document.addEventListener('astro:after-swap', side);
      })();
    </script>
  </head>
  <body>
    <Splash />
    <div class="app">
      <aside class="side">
        <div class="top">
          <a class="brand" href="/">iTender</a>
          <button type="button" class="collapse" data-toggle-side aria-label="Collapse sidebar" title="Collapse sidebar">
            <Icon icon={SidebarLeftIcon} />
          </button>
        </div>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={{ on: navOn === n.key }} aria-current={navOn === n.key ? 'page' : undefined} title={n.label}>
              <span class="item"><Icon icon={n.icon} /><span class="label">{n.label}</span></span>
              {n.count ? <>{" "}<span class="count">{n.count}<span class="visually-hidden"> {n.hint}</span></span></> : null}
            </a>
          ))}
        </nav>
      </aside>
      <main data-toast={toast}>
        <Banner items={desk.bannerItems()} />
        <slot />
      </main>
    </div>
    <Toast />
  </body>
</html>

<script>
  const label = () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-toggle-side]');
    const text = document.documentElement.dataset.side === 'collapsed' ? 'Expand sidebar' : 'Collapse sidebar';
    btn?.setAttribute('aria-label', text);
    btn?.setAttribute('title', text);
  };
  document.addEventListener('astro:page-load', label);
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-toggle-side]')) return;
    const next = document.documentElement.dataset.side === 'collapsed' ? 'open' : 'collapsed';
    document.documentElement.dataset.side = next;
    localStorage.setItem('td-side', next);
    label();
  });
</script>

<style>
  .app {
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr);
    min-height: 100vh;
  }

  .side {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    height: 100vh;
    padding: 28px 16px 24px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: var(--soft);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .collapse {
    border: none;
    background: none;
    color: var(--muted);
    width: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .collapse:hover {
    background: var(--line);
    color: var(--ink);
  }

  /* Collapsed: an icon-only rail. Labels stay readable to screen readers. */
  :global(html[data-side="collapsed"]) .app {
    grid-template-columns: 76px minmax(0, 1fr);
  }

  :global(html[data-side="collapsed"]) .side {
    padding-inline: 16px;
  }

  :global(html[data-side="collapsed"]) .top {
    justify-content: center;
  }

  :global(html[data-side="collapsed"]) .brand {
    display: none;
  }

  :global(html[data-side="collapsed"]) .side nav a {
    position: relative;
    justify-content: center;
    padding: 0;
  }

  :global(html[data-side="collapsed"]) .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  :global(html[data-side="collapsed"]) .count {
    position: absolute;
    top: 2px;
    right: -2px;
    min-width: 18px;
    padding: 0 5px;
    font-size: 11px;
  }

  .brand {
    font-size: 21px;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--forest);
    padding: 0 14px;
  }

  .side nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }

  .side nav a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .side nav a:hover {
    background: var(--line);
    color: var(--ink);
  }

  .side nav a.on {
    background: var(--range);
    color: var(--forest);
    font-weight: 700;
  }

  .count {
    background: var(--forest);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    min-width: 24px;
    padding: 1px 8px;
    border-radius: 9999px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
/* right grid styling */
  main {
    padding: 32px 48px 96px;
    max-width: 100%;
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 860px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: sticky;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-right: none;
      border-bottom: 1px solid var(--line);
      z-index: 10;
    }

    /* Covers the notch area above the sticky bar. */
    :global(body)::before {
      content: "";
      position: fixed;
      inset: 0 0 auto;
      height: env(safe-area-inset-top, 0px);
      z-index: 11;
      background: var(--page);
    }

    .collapse {
      display: none;
    }

    :global(html[data-side="collapsed"]) .app {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(html[data-side="collapsed"]) .side {
      padding-inline: 16px;
    }

    :global(html[data-side="collapsed"]) .brand {
      display: block;
    }

    :global(html[data-side="collapsed"]) .side nav a {
      padding: 0 14px;
    }

    :global(html[data-side="collapsed"]) .label {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }

    :global(html[data-side="collapsed"]) .count {
      position: static;
    }

    .brand {
      padding: 0;
      font-size: 18px;
      white-space: nowrap;
    }

    .side nav {
      flex-direction: row;
      overflow-x: auto;
      gap: 2px;
    }

    main {
      padding: 24px 20px 80px;
    }
  }
</style>
