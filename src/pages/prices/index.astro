---
// Prices: what do these jobs go for?
import { actions } from 'astro:actions';
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import Dash from '../../components/Dash.astro';
import Icon from '../../components/Icon.astro';
import { Add01Icon, Delete02Icon } from '@hugeicons/core-free-icons';
import PriceBand from '../../components/islands/PriceBand.svelte';
import { WORK_LABEL, WORK_PLURAL } from '../../lib/desk.ts';
import { rand } from '../../lib/money.ts';
import { MIN_WINS_FOR_RANGE, pricePoints, suggestedRange } from '../../lib/prices.ts';

if (Astro.getActionResult(actions.deleteRegister)?.data) return Astro.redirect('/prices');
const desk = await Astro.locals.desk();
const registers = desk.registers;
const bidCount = registers.reduce((a, r) => a + r.bids.length, 0);

const groups = (['website', 'system', 'design'] as const)
  .map((w) => {
    const points = pricePoints(registers, w);
    const wins = points.filter((p) => p.won).map((p) => p.priceCents);
    return { w, points, wins, range: suggestedRange(points) };
  })
  .filter((g) => g.points.length > 0);

const winLine = groups
  .filter((g) => g.wins.length)
  .map((g) => g.wins.length === 1
    ? `One winning ${WORK_PLURAL[g.w]} bid so far, at ${rand(g.wins[0])}.`
    : `Winning ${WORK_PLURAL[g.w]} jobs went for ${rand(Math.min(...g.wins))} to ${rand(Math.max(...g.wins))}.`)
  .join(' ');
---
<Layout title="Prices">
  <div class="title-row">
    <h1>Prices</h1>
    <a class="btn with-icon" href="/prices/add"><Icon icon={Add01Icon} size={18} />Add a Bid Register</a>
  </div>
  <p class="lede" style="margin-bottom:32px">
    {registers.length
      ? `${bidCount} ${bidCount === 1 ? 'bid' : 'bids'} from ${registers.length} bid ${registers.length === 1 ? 'register' : 'registers'}. ${winLine}`
      : 'No prices recorded yet.'}
  </p>
  {registers.length ? (
    <div class="cols">
      <section style="flex:2 1 540px">
        <div class="tablebox">
          <table style="min-width:480px">
            <thead><tr><th class="col-number">#</th><th>Bid register</th><th>Bids</th><th>Winning bid</th><th class="col-actions">Actions</th></tr></thead>
            <tbody>
              {registers.map((r, i) => {
                const win = r.bids.find((b) => b.won)?.priceCents;
                return (
                  <tr>
                    <td class="col-number">{i + 1}</td>
                    <td>
                      {r.ocid ? <a class="tname" href={`/tenders/${encodeURIComponent(r.ocid)}`}>{r.job ?? 'Untitled job'}</a>
                        : r.sourceFile ? <a class="tname" href={`/files/${r.sourceFile}`} target="_blank" data-astro-reload>{r.job ?? 'Untitled job'}</a>
                        : <span style="font-weight:600">{r.job ?? <Dash />}</span>}
                      <div class="sub">{[r.entity, r.year].filter(Boolean).join(', ')}{r.ocid && '. From your result in My bids'}</div>
                    </td>
                    <td class="num">{r.bids.length}</td>
                    <td class="num">{win ? rand(win) : <Dash />}</td>
                    <td class="col-actions">{!r.ocid && (
                      <form method="POST" action={actions.deleteRegister} style="margin:0"><input type="hidden" name="id" value={r.id} /><button type="submit" class="btn small with-icon"><Icon icon={Delete02Icon} size={16} />Remove</button></form>
                    )}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
      <section style="flex:1 1 280px">
        {groups.map((g) => (
          <div class="section">
            <h2>{WORK_LABEL[g.w]} jobs</h2>
            <p class="sub" style="margin:0 0 18px">
              Every bid you’ve recorded, on one line.
              {!g.range && ` There aren’t enough winning bids for a range yet: it needs ${MIN_WINS_FOR_RANGE}, you have ${g.wins.length}.`}
            </p>
            <PriceBand points={g.points} range={g.range} />
          </div>
        ))}
      </section>
    </div>
  ) : (
    <EmptyState>Record a result in My bids, or add a bid register from a past tender, and prices show here.</EmptyState>
  )}
</Layout>

